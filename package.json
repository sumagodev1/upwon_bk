{
  "name": "upwon-admin-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Upwon Admin Panel Backend - internal platform administration API",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "migrate": "tsx src/database/migrations/migrate.ts",
    "migrate:status": "tsx src/database/migrations/migrate.ts --status",
    "seed": "tsx src/database/seeds/seed.ts",
    "db:setup": "npm run migrate && npm run seed",
    "test": "node --test --import tsx \"src/**/*.test.ts\"",
    "audit:routes": "node scripts/route-audit.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "qs": "^6.15.4"
  }
}
