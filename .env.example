# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# ── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upwon_admin
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSL=false

# ── JWT ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The two secrets MUST be different. Minimum 32 characters each.
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_ISSUER=upwon-admin-api
JWT_AUDIENCE=upwon-admin-panel

# ── Security ─────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_SESSIONS_PER_ADMIN=5
PASSWORD_RESET_TTL_MINUTES=30
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG

# ── Storage ──────────────────────────────────────────────────────────────
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/api/files
MAX_UPLOAD_BYTES=10485760

# ── Seeding (used only by npm run seed) ──────────────────────────────────
SEED_SUPER_ADMIN_EMAIL=superadmin@upwon.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026Admin
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin

# ── Shutdown ─────────────────────────────────────────────────────────────
SHUTDOWN_GRACE_MS=15000
